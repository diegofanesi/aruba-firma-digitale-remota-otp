# Pure-Python library from PyPI, packaged here because it is not in the official
# Arch repositories. Installed straight from the wheel (no build step).
pkgname=python-pyhanko-certvalidator
_wheel=pyhanko_certvalidator-0.33.0-py3-none-any.whl
pkgver=0.33.0
pkgrel=1
pkgdesc="Validates X.509 certificates and paths; extracts trust data"
arch=('any')
url="https://pypi.org/project/pyhanko-certvalidator/"
license=('MIT')
depends=('python' 'python-asn1crypto' 'python-oscrypto' 'python-cryptography' 'python-uritools' 'python-requests' 'python-aiohttp' 'python-certifi')
makedepends=('python-installer')
source=("https://files.pythonhosted.org/packages/e8/22/fc8a485269187b85eadd2cf536b92be403a238932e7d3943ba176fb31041/pyhanko_certvalidator-0.33.0-py3-none-any.whl")
sha256sums=('72d3b830c0427a7aae45873ba7b4e34cb86caed451eff9dfb4394a69e93bb169')
noextract=("$_wheel")

package() {
  python -m installer --destdir="$pkgdir" "$srcdir/$_wheel"
}
