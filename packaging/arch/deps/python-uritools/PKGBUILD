# Pure-Python library from PyPI, packaged here because it is not in the official
# Arch repositories. Installed straight from the wheel (no build step).
pkgname=python-uritools
_wheel=uritools-7.0.1-py3-none-any.whl
pkgver=7.0.1
pkgrel=1
pkgdesc="RFC 3986 compliant URI parsing and handling"
arch=('any')
url="https://pypi.org/project/uritools/"
license=('MIT')
depends=('python')
makedepends=('python-installer')
source=("https://files.pythonhosted.org/packages/a0/20/075b0b5bed54848fd685b1354fe130983ed3b3b008c6818c8b1ef135181e/uritools-7.0.1-py3-none-any.whl")
sha256sums=('68ef533cebb6b5b6a79cc94c9e8c06d7521e3fe60a11f6689ec51795f25b4617')
noextract=("$_wheel")

package() {
  python -m installer --destdir="$pkgdir" "$srcdir/$_wheel"
}
