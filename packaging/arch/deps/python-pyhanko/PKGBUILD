# Pure-Python library from PyPI, packaged here because it is not in the official
# Arch repositories. Installed straight from the wheel (no build step).
pkgname=python-pyhanko
_wheel=pyhanko-0.38.2-py3-none-any.whl
pkgver=0.38.2
pkgrel=1
pkgdesc="Tools for stamping and signing PDF files (used by aruba-firma for signature verification)"
arch=('any')
url="https://pypi.org/project/pyHanko/"
license=('MIT')
depends=('python' 'python-asn1crypto' 'python-cryptography' 'python-pyhanko-certvalidator' 'python-tzlocal' 'python-lxml' 'python-requests' 'python-aiohttp' 'python-xsdata' 'python-signxml')
makedepends=('python-installer')
source=("https://files.pythonhosted.org/packages/7b/7f/01b57148a40097e5845bf71d46297295391fe19c7a4a5b1382eaa5eeba1f/pyhanko-0.38.2-py3-none-any.whl")
sha256sums=('041051105ddf3ace6571605ddccae0f3e444a6e99f0bd54ec88281684282ad41')
noextract=("$_wheel")

package() {
  python -m installer --destdir="$pkgdir" "$srcdir/$_wheel"
}
